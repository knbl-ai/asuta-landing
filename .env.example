# Public URL of the site (used for metadata and the Salesforce retURL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: serve the site under a sub-path, e.g. /ashdod
# NEXT_BASE_PATH=

# Salesforce Web-to-Lead
# mock = log leads locally (leads.dev.log) instead of sending them; live = POST to Salesforce
SF_MODE=mock
# UAT sandbox. Production is https://webto.salesforce.com/servlet/servlet.WebToLead?encoding=UTF-8
SF_ENDPOINT=https://test.salesforce.com/servlet/servlet.WebToLead?encoding=UTF-8
SF_OID=00D7E000000FWtK
# Custom Lead field that stores the Google Ads click id
SF_GCLID_FIELD=00NWl000000Q9E9
# Debug mode: Salesforce emails a field-mapping report for every lead. Never enable in production.
SF_DEBUG=0
SF_DEBUG_EMAIL=
